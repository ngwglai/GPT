{
  "name": "entropylab",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "test:e2e": "playwright test",
    "bench": "vitest run --config benchmark.config.ts",
    "bench:browser": "node bench/browser.mjs"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.30",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
