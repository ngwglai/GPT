    "smoke": "node scripts/smoke.mjs",
    "privacy": "node scripts/privacy-check.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "html-to-text": "10.0.1",
    "postal-mime": "4.1.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/html-to-text": "9.0.4",
    "@types/node": "26.6.5",
    "miniflare": "5.20261023.1-beta",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "wrangler": "4.154.0"
  },
  "private": true
