{
  "name": "bili-observer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types --strict-vars false",
    "check": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "configure": "python scripts/configure.py",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "jose": "6.2.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.161.0"
  }
}
