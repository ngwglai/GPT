{
  "name": "rogue-survivor",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "simulate": "tsx tests/simulate.ts",
    "docs:cards": "tsx tools/card-docs.ts",
    "simulate:shuffle": "tsx tests/simulate.ts --shuffle",
    "simulate:worlds": "tsx tools/world-check.ts",
    "test:mobile:webkit": "playwright test -c playwright.mobile.config.ts",
    "simulate:economy": "tsx tools/economy-check.ts",
    "simulate:builds": "tsx tools/build-check.ts",
    "simulate:expeditions": "tsx tools/expedition-check.ts",
    "report:growth": "tsx tools/enemy-growth-report.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
